<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Company>Entremuros SACS</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Aukenid.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyOcrAssets" AfterTargets="Build">
    <PropertyGroup>
      <_CoreOut>$(MSBuildThisFileDirectory)..\src\bin\$(Configuration)\net10.0\</_CoreOut>
    </PropertyGroup>
    <ItemGroup>
      <_OcrNative Include="$(_CoreOut)libtesseract*.dylib;$(_CoreOut)libleptonica*.dylib;$(_CoreOut)tesseract*.dll;$(_CoreOut)leptonica*.dll" />
      <_TessData Include="$(_CoreOut)tessdata\*.traineddata" />
    </ItemGroup>
    <Copy SourceFiles="@(_OcrNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_OcrNative)' != ''" />
    <Copy SourceFiles="@(_TessData)" DestinationFolder="$(OutputPath)tessdata\" SkipUnchangedFiles="true" Condition="'@(_TessData)' != ''" />
  </Target>

</Project>
